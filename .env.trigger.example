# Copy to .env.trigger to run Staging background jobs on your computer with
# `pnpm trigger:dev`. Every value points at Staging, never Production.
# Production jobs read the same names from the Trigger.dev dashboard.
# See "Environment variables and secrets" in README.md.

# Staging database login for the limited tracer_app user (Neon console > Connect).
DATABASE_URL=
# Staging database login for tracer_migration. Only pnpm fixtures:retention needs it.
DATABASE_MIGRATION_URL=

# Must equal the tracer-staging Worker's TWILIO_CREDENTIAL_MASTER_KEY secret.
TWILIO_CREDENTIAL_MASTER_KEY=

# R2 token with Object Read and Write on tracer-recordings-staging only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tracer-recordings-staging

# Trigger.dev Dev environment secret key (dashboard > API Keys), so jobs can start other jobs.
TRIGGER_SECRET_KEY=

# OpenAI project key. Without it, transcripts and lead scores stay Pending.
OPENAI_API_KEY=
