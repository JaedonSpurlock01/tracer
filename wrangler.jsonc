{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "previews": {
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE",
        "id": "36fd65b2679c4b739d224f1056b29070"
      }
    ],
    "send_email": [
      {
        "name": "EMAIL",
        "remote": true
      }
    ],
    "r2_buckets": [
      {
        "binding": "R2",
        "bucket_name": "tracer-recordings-staging"
      }
    ],
    "vars": {
      "R2_BUCKET": "tracer-recordings-staging"
    }
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tracer"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c7bee152d6814904b4244700482815e2",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/tracer"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "tracer-recordings-production"
    }
  ],
  "vars": {
    "R2_BUCKET": "tracer-recordings-production"
  },
  "env": {
    "staging": {
      "name": "tracer-staging",
      "send_email": [
        {
          "name": "EMAIL",
          "remote": true
        }
      ],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "19a5d9e69d2a4a82b33c5d3f8cf2480f",
          "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/tracer"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "tracer-recordings-staging"
        }
      ],
      "vars": {
        "R2_BUCKET": "tracer-recordings-staging"
      }
    }
  }
}
