# Copy to .env only if you run maintenance commands against a real database
# or use `pnpm dev` instead of `pnpm dev:local`. Local development with
# `pnpm dev:local` needs no .env. Never put Production values here.
# See "Environment variables and secrets" in README.md.

# Your Cloudflare account ID and an API token. Used by Wrangler and by
# scripts/configure-report-lifecycle.ts (needs R2 bucket settings edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Database login for the tracer_migration user, which may change tables.
# Used by pnpm db:migrate, db:grant-runtime, auth:bootstrap, fixtures:retention.
DATABASE_MIGRATION_URL=
# Password for the limited tracer_app user. Only pnpm db:grant-runtime needs it.
DATABASE_RUNTIME_PASSWORD=

# Only for `pnpm dev`. A random value (openssl rand -base64 32) that signs login cookies.
BETTER_AUTH_SECRET=
# Only for `pnpm dev`. The address you open in the browser.
BETTER_AUTH_URL=http://localhost:3000
# Only for `pnpm dev`. The sender of sign-in codes, on a domain onboarded to Cloudflare Email Sending.
AUTH_EMAIL_FROM=
# Only for `pnpm dev`. Comma-separated emails allowed to receive a sign-in code.
AUTH_EMAIL_ALLOWED_RECIPIENTS=
# Only for `pnpm dev`. Random value (openssl rand -base64 32) that locks stored provider passwords.
TWILIO_CREDENTIAL_MASTER_KEY=
