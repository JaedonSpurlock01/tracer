{
  "name": "tracer",
  "version": "0.0.0",
  "private": true,
  "description": "Tracer call-tracking application",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:local": "cross-env-shell E2E_AUTH_FAKE=true E2E_CLOUDFLARE_FAKE=true E2E_DATAFORSEO_FAKE=true E2E_OPENAI_FAKE=true DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:5433/tracer BETTER_AUTH_URL=http://127.0.0.1:3000 BETTER_AUTH_SECRET=local-dev-only-secret-not-a-credential AUTH_EMAIL_FROM=auth@example.com AUTH_EMAIL_ALLOWED_RECIPIENTS=spurjae@gmail.com TWILIO_CREDENTIAL_MASTER_KEY=bG9jYWwtZGV2LW9ubHktbWFzdGVyLWtleS0zMmJ5dGU= \"drizzle-kit migrate && next dev\"",
    "build": "corepack pnpm cf-typegen && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:provision": "tsx scripts/provision-data-platform.ts",
    "db:grant-runtime": "tsx scripts/grant-runtime-role.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-initial-operator.ts",
    "smoke:staging-call": "tsx scripts/staging-call-smoke.ts",
    "fixtures:retention": "tsx scripts/seed-retention-fixtures.ts",
    "trigger:dev": "trigger dev start --env-file .env.trigger",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:deploy": "opennextjs-cloudflare build && wrangler preview",
    "cf-typegen": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false CLOUDFLARE_INCLUDE_PROCESS_ENV=false wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test": "corepack pnpm test:vitest && corepack pnpm test:workers",
    "test:vitest": "vitest run --config vitest.config.ts --project domain --project contracts --project tasks --project components --project harness",
    "test:domain": "vitest run --config vitest.config.ts --project domain --passWithNoTests",
    "test:integration": "vitest run --config vitest.config.ts --project integration --passWithNoTests",
    "test:contracts": "vitest run --config vitest.config.ts --project contracts --passWithNoTests",
    "test:workers": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false CLOUDFLARE_INCLUDE_PROCESS_ENV=false vitest run --config vitest.workers.config.ts",
    "test:tasks": "vitest run --config vitest.config.ts --project tasks --passWithNoTests",
    "test:components": "vitest run --config vitest.config.ts --project components",
    "test:harness": "vitest run --config vitest.config.ts --project harness",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:smoke": "vitest run --config vitest.config.ts --project smoke --passWithNoTests",
    "typecheck": "next typegen && corepack pnpm cf-typegen && tsc --noEmit",
    "lint": "eslint .",
    "verify": "corepack pnpm test && corepack pnpm typecheck && corepack pnpm lint",
    "verify:full": "corepack pnpm test && corepack pnpm test:integration && corepack pnpm test:e2e && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@react-pdf/renderer": "4.9.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.21",
    "@trigger.dev/sdk": "4.7.2",
    "@xyflow/react": "12.12.0",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.3",
    "geist": "1.7.2",
    "input-otp": "1.5.0",
    "lucide-react": "1.55.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "pg-cloudflare": "1.4.1",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "recharts": "3.8.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@opennextjs/cloudflare": "1.20.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@trigger.dev/build": "4.7.2",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "fflate": "0.8.3",
    "jsdom": "30.1.2",
    "jsonc-parser": "3.3.1",
    "pdfjs-dist": "6.4.299",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.0",
    "trigger.dev": "4.7.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
